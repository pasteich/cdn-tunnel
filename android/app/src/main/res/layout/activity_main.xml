<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== TUNNEL TAB ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tab_tunnel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="14dp">
                    <View
                        android:layout_width="0dp" android:layout_height="1dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tv_conn"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="● offline"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Status card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Отключено"
                        android:textSize="20sp" android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/tv_status_detail"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Заполните поля и нажмите «Запустить VPN»"
                        android:textSize="13sp"
                        android:paddingTop="2dp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/tv_users_live"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="👥 Подключено —"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:paddingTop="6dp"
                        android:visibility="gone"
                        android:textColor="?attr/colorPrimary" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:trackCornerRadius="3dp" />
                </LinearLayout>

                <TextView style="@style/Section" android:text="Профиль" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="Твоё имя (видно друзьям в списке)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:fontFamily="monospace"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="cdn://…">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_link"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textMultiLine" android:fontFamily="monospace"
                        android:textSize="12sp" android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_import"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:text="Импортировать" android:textStyle="bold"
                        app:cornerRadius="14dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_paste"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:text="Из буфера" app:cornerRadius="14dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_profile"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Сервер не задан"
                    android:textSize="12sp" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="6dp" />

                <!-- Ручная настройка (свёрнута: обычно хватает ссылки) -->
                <LinearLayout
                    android:id="@+id/hdr_manual"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ручная настройка"
                        android:textAllCaps="true" android:textStyle="bold"
                        android:textSize="13sp" android:letterSpacing="0.08"
                        android:alpha="0.6" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/chev_manual"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▸" android:textColor="?attr/colorPrimary" android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/box_manual"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">

                <TextView style="@style/Section" android:text="Подключение" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="IP сервера CDN">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ip"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:fontFamily="monospace"
                        android:digits="0123456789.:abcdefABCDEF"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="Host / SNI (домен CDN)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_host"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:fontFamily="monospace"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="Мастер-ключ (вход без ссылки)"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:fontFamily="monospace"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Нужен только владельцу сервера, чтобы зайти напрямую. По ссылке cdn:// поле не заполняется и не требуется."
                    android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="10dp" />

                <LinearLayout style="@style/Row">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="Локальный порт SOCKS"
                        android:layout_marginEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_port"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:fontFamily="monospace"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="Соединений (conns)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_conns"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:fontFamily="monospace"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout style="@style/Row">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Dropdown" android:hint="Транспорт"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginEnd="10dp" android:layout_marginBottom="0dp">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dd_transport"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="none" android:fontFamily="monospace"
                            android:text="chunked" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Dropdown" android:hint="Метод (HTTP)"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginBottom="0dp">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dd_method"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="none" android:fontFamily="monospace"
                            android:text="post" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="stream — ниже пинг, но нужен CDN без буферизации тела; иначе авто-откат на chunked"
                    android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingTop="4dp" android:paddingBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingVertical="4dp">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="UDP через туннель"
                            android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="QUIC / игры по UDP (иначе DNS-over-TCP)"
                            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_udp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Advanced (collapsible) -->
                <LinearLayout
                    android:id="@+id/hdr_advanced"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Дополнительно"
                        android:textAllCaps="true" android:textStyle="bold"
                        android:textSize="13sp" android:letterSpacing="0.08"
                        android:alpha="0.6" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/chev_advanced"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▸" android:textColor="?attr/colorPrimary" android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/box_advanced"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">

                    <LinearLayout style="@style/Row">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Field.Half" android:hint="DNS сервер"
                            android:layout_marginEnd="10dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_dns"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="text" android:fontFamily="monospace"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Field.Half" android:hint="MTU">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_mtu"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:fontFamily="monospace"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingVertical="4dp">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Блокировать IPv6 (AAAA)"
                            android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_block_aaaa"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingVertical="4dp">
                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Fast Open (0-RTT connect)"
                                android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="убирает 1 RTT на соединение"
                                android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_fastopen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingVertical="4dp">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Подробный лог (debug)"
                            android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_debug"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wipe"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Стереть все настройки" android:textColor="@color/danger" />

                </LinearLayout><!-- /box_manual -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:text="Запустить VPN"
                    android:textSize="16sp" android:textStyle="bold"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===================== TRAFFIC TAB ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tab_traffic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">



                <!-- Download card -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg"
                    android:padding="18dp" android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="↓ ЗАГРУЗКА" android:textStyle="bold" android:letterSpacing="0.08"
                        android:textSize="13sp" android:textColor="@color/down" />
                    <TextView android:id="@+id/tv_down_total"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 B" android:textSize="34sp" android:textStyle="bold"
                        android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/tv_down_rate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 B/s" android:textSize="15sp"
                        android:fontFamily="monospace" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Upload card -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/card_bg"
                    android:padding="18dp" android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="↑ ОТДАЧА" android:textStyle="bold" android:letterSpacing="0.08"
                        android:textSize="13sp" android:textColor="@color/up" />
                    <TextView android:id="@+id/tv_up_total"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 B" android:textSize="34sp" android:textStyle="bold"
                        android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/tv_up_rate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 B/s" android:textSize="15sp"
                        android:fontFamily="monospace" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- small stats row -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/card_bg" android:padding="14dp"
                        android:layout_marginEnd="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Соединения" android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:id="@+id/tv_conns"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="22sp" android:textStyle="bold"
                            android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/card_bg" android:padding="14dp"
                        android:layout_marginStart="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Пинг (RTT)" android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:id="@+id/tv_rtt"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="— ms" android:textSize="22sp" android:textStyle="bold"
                            android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/card_bg" android:padding="14dp"
                        android:layout_marginEnd="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="UDP ↓ / ↑" android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:id="@+id/tv_udp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 B / 0 B" android:textSize="18sp" android:textStyle="bold"
                            android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:background="@drawable/card_bg" android:padding="14dp"
                        android:layout_marginStart="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Пользователи" android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:id="@+id/tv_users"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="18sp" android:textStyle="bold"
                            android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingTop="18dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Журнал"
                        android:textStyle="bold" android:textSize="16sp"
                        android:textColor="?attr/colorPrimary" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Очистить" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_bg" android:padding="10dp"
                    android:fontFamily="monospace" android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===================== USERS TAB ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tab_users"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingBottom="14dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Пользователи"
                        android:fontFamily="monospace" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />
                    <TextView
                        android:id="@+id/tv_users_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—"
                        android:fontFamily="monospace" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/box_users"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_users_hint"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Список приходит с сервера, пока VPN запущен. Каждый клиент виден под своим именем (поле «Твоё имя» на вкладке «Туннель», флаг -name у бинарника)."
                    android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===================== SERVER TAB ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tab_server"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Сервер"
                    android:fontFamily="monospace" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" android:paddingBottom="4dp" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Разворачивает сервер на VPS по SSH (systemd, автозапуск при ребуте). После деплоя — «Управление»: юзеры, трафик, лимиты, ссылки."
                    android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="14dp" />

                <TextView style="@style/Section" android:text="VPS · SSH" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="Адрес VPS (IP или домен)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ssh_host"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:fontFamily="monospace" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout style="@style/Row">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="SSH-порт" android:layout_marginEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ssh_port"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:fontFamily="monospace" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="Пользователь">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ssh_user"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="text" android:fontFamily="monospace" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="SSH-пароль"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ssh_pass"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:fontFamily="monospace" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView style="@style/Section" android:text="Сервер туннеля" />

                <LinearLayout style="@style/Row">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="Слушать (-addr)" android:layout_marginEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_server_addr"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="text" android:fontFamily="monospace" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Dropdown" android:hint="Метод (сервер)"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dd_server_method"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="none" android:fontFamily="monospace" android:text="both" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field" android:hint="Мастер-ключ сервера"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_server_pass"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:fontFamily="monospace" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Корень всей защиты: им подписываются ссылки cdn:// и открывается «Управление сервером». Друзьям он не нужен — они подключаются по ссылке, привязанной к их устройству. Оставьте пустым — сгенерируется сам при развёртывании."
                    android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gen_key"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Сгенерировать ключ" />

                <LinearLayout style="@style/Row">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="Рестарт, мин (0 = нет)"
                        android:layout_marginEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_restart_min"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:fontFamily="monospace" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field.Half" android:hint="Макс. юзеров (-users)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_server_users"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:fontFamily="monospace" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Сколько клиентов сервер обслуживает одновременно. 0 — без лимита; лишним отвечает 429, в журнале сервера — «достигнуто максимальное число подключений»."
                    android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_deploy"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:text="Развернуть" android:textStyle="bold"
                        app:cornerRadius="14dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_check"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content" android:layout_height="52dp"
                        android:text="Статус" app:cornerRadius="14dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="Управление сервером" android:textStyle="bold"
                    app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_uninstall"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Удалить с сервера" android:textColor="@color/danger" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/deploy_progress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:indeterminate="true"
                    android:visibility="gone" app:trackCornerRadius="3dp" />

                <ScrollView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:background="@drawable/card_bg"
                    android:padding="10dp" android:minHeight="120dp">
                    <TextView
                        android:id="@+id/tv_deploy"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Заполните поля VPS и нажмите «Развернуть»."
                        android:fontFamily="monospace" android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textIsSelectable="true" />
                </ScrollView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
