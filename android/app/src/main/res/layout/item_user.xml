<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_user_dot"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="15sp" android:paddingEnd="10dp" />
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:id="@+id/tv_user_state"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_user_traffic"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="13sp" android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tv_user_meta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textSize="12sp" android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="6dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_kick"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:text="Отключить" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_ban"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:text="Бан" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_forget"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:text="Забыть" android:textColor="@color/danger" />
    </LinearLayout>
</LinearLayout>
