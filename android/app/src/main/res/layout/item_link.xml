<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_link_title"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:id="@+id/tv_link_state"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_link_meta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="12sp" android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tv_link_traffic"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textSize="13sp" android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurface" />

    <HorizontalScrollView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:scrollbars="none">
    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_link_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="12sp" android:text="Поделиться" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_link_kick"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="12sp" android:text="Сбросить" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_link_unbind"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="12sp" android:text="Отвязать" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_link_revoke"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="12sp" android:text="Отозвать" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_link_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:textSize="12sp" android:text="Удалить" android:textColor="@color/danger" />
    </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
